# ============================================================================
#  ChatDFT — 提交范围
#  原则：仓库只装「人和代码」，不装「这台机器上跑出来的东西」。
#  下面每一块都写清楚为什么排除——下次有人想加回来，先读理由。
# ============================================================================

# ---------------------------------------------------------------------------
# 密钥。data/llm.json 里有一把真实的 API key（实测 35 字符，sk- 开头）。
# 绝对不许进仓库。格式模板见 data/llm.example.json。
# ---------------------------------------------------------------------------
data/llm.json

# ---------------------------------------------------------------------------
# 构建工具链与中间产物，约 2.1 GB，且全部可重建。
#   build/   1.3 GB — PySCF/libcint/libxc 的编译中间产物，里面还嵌着
#                    四个 .git（libcint、xcfun），提交进来会变成坏掉的
#                    gitlink（空目录），克隆出来无法使用。
#   tools/   774 MB — MinGW-w64 工具链 + mingw.7z（单个文件 79.9 MB，
#                    虽未触及 GitHub 100 MB 硬限，但已远超 50 MB 告警线）。
#   build.log / 构建脚本的输出
# 重建方式见 build_pyscf.bat 与 install_pyscf.py。
# ---------------------------------------------------------------------------
build/
tools/
build.log

# ---------------------------------------------------------------------------
# 运行时产物，可重新算出。
#   data/cubes/     382 MB — 260 个 .cube 体数据，由 SCF/NTO 作业按需生成
#                            （server.py 的 CHATDFT_CUBE_DIR；门禁自己也
#                             把它改指到 scratch 目录）。
#   data/nci_test/   21 MB — NCI 测试用的临时体系。
# ---------------------------------------------------------------------------
data/cubes/
data/nci_test/
data/server.log
data/design_cache/

# ---------------------------------------------------------------------------
# 临时探针与日志。审计过程里的量测脚本（probe_*.py）是源码、保留；
# 它们和门禁写出的 .log 是噪声，不保留。
# ---------------------------------------------------------------------------
.tmp_probe/
*.log
*.out

# ---------------------------------------------------------------------------
# 助手工作区（.workbuddy-ai/）：里面是 AI 助手自己的记忆与工作日志，
# 不是项目源码。审计的成稿在 reports/*.html 里，那份是要发布的。
# 想连工作日志一起发布，删掉这一条即可。
# ---------------------------------------------------------------------------
.workbuddy-ai/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
